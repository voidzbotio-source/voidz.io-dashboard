DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
SESSION_SECRET=change-this-to-something-random
MICROSOFT_EMAIL=you@outlook.com

# Set to true only when serving behind HTTPS (directly or via a
# TLS-terminating reverse proxy) so the session cookie is marked Secure.
# COOKIE_SECURE=true

# Server-side escape hatch to turn OFF the admin's two-factor auth, e.g.
# if a lost authenticator ever locks you out. Leave unset normally.
# DISABLE_2FA=true

# Lets the server boot even with the placeholder DASHBOARD_PASSWORD /
# SESSION_SECRET above. For throwaway local testing ONLY - never in
# production, where those defaults would leave the dashboard wide open.
# ALLOW_INSECURE_DEFAULTS=true
